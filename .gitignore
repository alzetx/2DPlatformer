# Keep these — they are required for project versioning and builds
!/[Pp]rojectSettings/
!/[Pp]ackages/
!/[Aa]ssets/

# Ignore temporary Unity package manager files
/[Pp]ackages/manifest-temp.json
/[Pp]ackages/packages-lock-backup.json

